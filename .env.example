# ═══════════════════════════════════════════════════════════════════════════════
#  FlowForge Environment Configuration
#  Copy this file to .env and fill in your values.
#  Lines starting with # are comments.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────────────────────

NODE_ENV=development                         # development | production | test
FLOWFORGE_PORT=5678                          # HTTP server port
FLOWFORGE_HOST=0.0.0.0                       # Bind address
FLOWFORGE_WEBHOOK_URL=http://localhost:5678  # Public-facing URL for webhooks
FLOWFORGE_EDITOR_BASE_URL=http://localhost:5173

# ─── Security (REQUIRED — change these!) ─────────────────────────────────────

# Must be at least 32 characters. Used for AES-256-GCM credential encryption.
FLOWFORGE_ENCRYPTION_KEY=change-me-in-production-32-chars!!

# Must be at least 32 characters. Used for JWT signing.
JWT_SECRET=change-me-jwt-secret-32-chars!!!!

COOKIE_SECRET=change-me-cookie-secret

# ─── Database ─────────────────────────────────────────────────────────────────

# sqlite | postgres | mysql
DB_TYPE=sqlite

# SQLite (development)
DB_SQLITE_DATABASE=./flowforge.db

# PostgreSQL (recommended for production)
# DB_TYPE=postgres
# DB_POSTGRESDB_HOST=localhost
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=flowforge
# DB_POSTGRESDB_USER=flowforge
# DB_POSTGRESDB_PASSWORD=your-db-password
# DB_POSTGRESDB_SCHEMA=public

# MySQL (alternative)
# DB_TYPE=mysql
# DB_MYSQLDB_HOST=localhost
# DB_MYSQLDB_PORT=3306
# DB_MYSQLDB_DATABASE=flowforge
# DB_MYSQLDB_USER=flowforge
# DB_MYSQLDB_PASSWORD=your-db-password

# ─── Execution Mode ───────────────────────────────────────────────────────────

# regular = single process (dev / small deployments)
# queue   = Bull + Redis workers (production / scaling)
EXECUTIONS_MODE=regular

# Timeout per workflow execution in seconds (0 = no limit)
EXECUTIONS_TIMEOUT=0
EXECUTIONS_TIMEOUT_MAX=3600

# Max concurrent executions in regular mode
FLOWFORGE_CONCURRENCY_PRODUCTION_LIMIT=10

# Execution data retention
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336          # hours before soft-delete (14 days)
EXECUTIONS_DATA_HARD_DELETE_BUFFER=48 # hours after soft-delete before hard-delete

# What to save
EXECUTIONS_DATA_SAVE_ON_ERROR=all    # all | none
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none # all | none
EXECUTIONS_DATA_SAVE_ON_PROGRESS=false

# ─── Redis / Bull Queue ───────────────────────────────────────────────────────

# Used when EXECUTIONS_MODE=queue
REDIS_URL=redis://localhost:6379
# -- OR -- configure components individually:
# QUEUE_BULL_REDIS_HOST=localhost
# QUEUE_BULL_REDIS_PORT=6379
# QUEUE_BULL_REDIS_PASSWORD=
# QUEUE_BULL_REDIS_DB=0

# ─── Binary Data Storage ──────────────────────────────────────────────────────

BINARY_DATA_MODE=filesystem          # filesystem | s3
BINARY_DATA_STORAGE_PATH=./binary-data

# S3 (when BINARY_DATA_MODE=s3)
# AWS_S3_BUCKET=my-flowforge-bucket
# AWS_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── External Secrets Provider ────────────────────────────────────────────────

# none | aws | azure | vault
EXTERNAL_SECRETS_PROVIDER=none

# AWS Secrets Manager
# EXTERNAL_SECRETS_AWS_REGION=us-east-1

# Azure Key Vault
# EXTERNAL_SECRETS_AZURE_VAULT_URL=https://my-vault.vault.azure.net

# ─── Authentication ───────────────────────────────────────────────────────────

JWT_EXPIRES_IN=7d
USER_MANAGEMENT_DISABLED=false

# LDAP
LDAP_ENABLED=false
# LDAP_HOST=ldap.example.com
# LDAP_PORT=389
# LDAP_BASE_DN=dc=example,dc=com
# LDAP_BIND_DN=cn=admin,dc=example,dc=com
# LDAP_BIND_PASSWORD=

# SAML 2.0
SAML_ENABLED=false

# OpenID Connect
OIDC_ENABLED=false
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:5678/rest/auth/oidc/callback

# ─── Rate Limiting ────────────────────────────────────────────────────────────

RATE_LIMIT_MAX=180                   # Max requests per window
RATE_LIMIT_WINDOW_MS=900000          # Window in ms (15 minutes)

# ─── SMTP / Email ─────────────────────────────────────────────────────────────

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@yourcompany.com

# ─── AI Providers ─────────────────────────────────────────────────────────────

# Anthropic Claude (recommended — used for AI Assistant by default)
ANTHROPIC_API_KEY=

# OpenAI GPT
OPENAI_API_KEY=

# AI Assistant model (default: claude-opus-4-20250514)
AI_ASSISTANT_MODEL=claude-opus-4-20250514

# ─── Observability ────────────────────────────────────────────────────────────

# error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# console | file | both
LOG_OUTPUT=console

# Sentry error tracking
# SENTRY_DSN=https://xxx@sentry.io/xxx

# OpenTelemetry
OTEL_ENABLED=false
# OTEL_ENDPOINT=http://localhost:4318

# ─── Third-Party Integrations (used by built-in nodes) ───────────────────────

# Slack
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=

# Stripe
# STRIPE_SECRET_KEY=

# SendGrid
# SENDGRID_API_KEY=

# Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Pinecone (for AI vector store node)
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ─── Development Only ─────────────────────────────────────────────────────────

# Set to true to disable SSL certificate verification (NEVER in production)
# NODE_TLS_REJECT_UNAUTHORIZED=0

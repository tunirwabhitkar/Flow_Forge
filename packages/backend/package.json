{
  "name": "@flowforge/backend",
  "version": "1.0.0",
  "description": "FlowForge backend — Express 5, TypeORM, auth, webhooks, queue",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:migrate": "tsx src/db/run-migrations.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@flowforge/core": "workspace:*",
    "@flowforge/nodes": "workspace:*",
    "express": "^5.0.0",
    "typeorm": "^0.3.20",
    "better-sqlite3": "^9.4.3",
    "pg": "^8.11.5",
    "zod": "^3.22.4",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "bull": "^4.12.9",
    "ioredis": "^5.3.2",
    "winston": "^3.13.0",
    "luxon": "^3.4.4",
    "uuid": "^9.0.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.2.0",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "passport-jwt": "^4.0.1",
    "node-cron": "^3.0.3",
    "axios": "^1.6.8",
    "form-data": "^4.0.0",
    "aws-sdk": "^2.1585.0",
    "@azure/keyvault-secrets": "^4.8.0",
    "speakeasy": "^2.0.0",
    "node-saml": "^4.0.5",
    "ldapjs": "^3.0.7",
    "openapi3-ts": "^4.2.2",
    "prom-client": "^15.1.2",
    "@opentelemetry/sdk-node": "^0.51.0",
    "@opentelemetry/auto-instrumentations-node": "^0.45.0",
    "@sentry/node": "^8.0.0",
    "node-fetch": "^3.3.2",
    "mime-types": "^2.1.35",
    "reflect-metadata": "^0.2.2",
    "dotenv": "^16.4.5",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/cors": "^2.8.17",
    "@types/multer": "^1.4.11",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/passport-jwt": "^4.0.1",
    "@types/better-sqlite3": "^7.6.10",
    "@types/pg": "^8.11.5",
    "@types/uuid": "^9.0.8",
    "@types/node": "^22.0.0",
    "@types/mime-types": "^2.1.4",
    "@types/speakeasy": "^2.0.10",
    "@types/ldapjs": "^3.0.7",
    "@types/swagger-ui-express": "^4.1.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "tsx": "^4.7.2",
    "typescript": "^5.4.0",
    "nock": "^13.5.4"
  }
}

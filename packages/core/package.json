  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/uuid": "^9.0.8",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.0"
  }
}

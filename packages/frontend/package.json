{
  "name": "@flowforge/frontend",
  "version": "1.0.0",
  "description": "FlowForge frontend — Vue 3 visual workflow editor",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "pinia": "^2.1.7",
    "element-plus": "^2.6.3",
    "@element-plus/icons-vue": "^2.3.1",
    "@vueflow/core": "^1.22.2",
    "@vueflow/background": "^1.22.2",
    "@vueflow/controls": "^1.22.2",
    "@vueflow/minimap": "^1.22.2",
    "codemirror": "^6.0.1",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.26.3",
    "@codemirror/state": "^6.4.1",
    "axios": "^1.6.8",
    "@vueuse/core": "^10.9.0",
    "vue-codemirror": "^6.1.1",
    "dayjs": "^1.11.10",
    "lodash-es": "^4.17.21",
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/test-utils": "^2.4.5",
    "@playwright/test": "^1.43.1",
    "vitest": "^1.5.0",
    "@vitest/ui": "^1.5.0",
    "vite": "^5.2.10",
    "vue-tsc": "^2.0.13",
    "typescript": "^5.4.0",
    "@types/lodash-es": "^4.17.12",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38"
  }
}
